{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "个人 GitHub 作品集：笔记档案 + 项目展示 + AI 画廊（Astro 5 + Pagefind）",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "python3 scripts/check_content.py",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "astro": "^5.2.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
