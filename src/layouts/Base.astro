---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = '个人 GitHub 作品集：笔记档案 · 项目展示 · 艺术画廊', wide = false } = Astro.props;
const year = new Date().getFullYear();

// 全局导航：首页精确匹配，其余按路径前缀高亮（aria-current）
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: '作品集' },
  { href: '/notes/', label: '笔记' },
  { href: '/projects/', label: '项目' },
  { href: '/gallery/', label: '画廊' },
  { href: '/resources/', label: '资源' },
  { href: '/about/', label: '关于' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- 开机动画（莱茵生命风 · 改编自开源项目 dsh-startup-screen，MIT，见 public/startup/LICENSE）：
         样式表 + 首屏兜底 CSS（动画未就绪时黑幕先盖上，绝不闪出界面本体） -->
    <link rel="stylesheet" href="/startup/splash.css" />
    <style is:inline>
      html.dsu-lock,html.dsu-lock body{overflow:hidden!important}
      html.dsu-lock body{background-color:#000!important}
      :root{--dsh-boot-bg:#000}
      #dsh-startup-root.dsu-boot{position:fixed;inset:0;z-index:2147483000;background:#000}
    </style>
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="作品集 · 个人档案" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    {/* 页面级 head 注入点（可选）：用于把关键样式/元信息放进 head 且晚于全局样式，
        保证同名令牌覆盖与 body/html/:root 选择器的层叠顺序（沉浸画廊页暗色令牌依赖此槽位） */}
    <slot name="head" />
  </head>
  <body>
    <!-- 开机动画挂载点（必须与 splash.js 的 ROOT_ID 一致；dsu-boot 类由首屏兜底 CSS 立即盖黑） -->
    <div id="dsh-startup-root" class="dsu-root dsu-boot"></div>
    <script is:inline>
      /* 开机动画配置（改编自 dsh-startup-screen；结构/时间线/音效与原版一致，仅品牌文案与徽标适配本站） */
      window.__DSH_STARTUP__ = {
        enabled: true,
        mode: 'session',          // always | session | daily：每会话一次
        theme: 'light',
        speed: 1,
        requireInteraction: true, // 第 1、2 步停下等按钮 / Enter / 空格
        allowSkip: true,          // 右上 SKIP / Esc
        sound: true,
        soundVolume: 0.5,
        voice: true,
        voiceLang: 'en',
        voiceName: '',
        voiceRate: 0.88,
        voicePitch: 0.85,
        voiceVolume: 0.9,
        voiceCue: true,
        sfx: 'audio',
        voiceSource: 'asset',
        voiceLead: 240,
        identity: 'READER',
        identityId: '0001',
        accessLevel: '3',
        brand1: 'SHANREN',
        brand2: 'PERSONAL ARCHIVE',
        brand3a: 'PORTFOLIO',
        brand3b: 'ARCHIVE',
        orgZh: '作品集',
        orgEn: 'PORTFOLIO',
        orgSub: 'PERSONAL ARCHIVE SITE',
        welcomeBox: 'PORTFOLIO',
        footer: 'BUILT WITH ASTRO · GITHUB PAGES',
        accent: '#ff7500',
        glitchA: '#ff3b30',
        glitchB: '#2971b8',
        glass: true,
        glassOpacity: 0.75,
        glassBlur: 22,
        glassSaturate: 160,
        glassBackdropBlur: 28
      };
      /* 本次是否播放的判定（原版 Host 侧 bootstrap 逻辑）+ 自动化环境豁免：
         webdriver（E2E/截图）或 URL 带 nosplash 参数 → 不播，避免门禁脚本被动画挡住 */
      (function(){try{
        var c=window.__DSH_STARTUP__||{};
        var root=document.getElementById('dsh-startup-root');
        var off=!c.enabled;
        if(!off&&c.mode==='session'&&sessionStorage.getItem('dsh-startup-screen:shown')==='1')off=true;
        if(!off&&c.mode==='daily'&&localStorage.getItem('dsh-startup-screen:day')===new Date().toISOString().slice(0,10))off=true;
        if(!off&&(navigator.webdriver||/[?&]nosplash(=|&|$)/.test(location.search)))off=true;
        /* 无障碍底线：系统设置「减少动效」的用户不播放片头 */
        if(!off&&window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)off=true;
        if(off){window.__DSH_STARTUP_SKIP__=true;if(root&&root.parentNode)root.parentNode.removeChild(root);}
        else{
          document.documentElement.classList.add('dsu-lock');
          /* 运行时按需加载：本次不播的访问（本会话已播过 / 自动化 / 减少动效）完全不拉这 60KB */
          var s=document.createElement('script');
          s.src='/startup/splash.js';s.defer=true;
          document.head.appendChild(s);
          /* 兜底：splash.js 都没跑起来（404/被拦/语法错）时 9 秒后无条件放行，绝不锁黑屏 */
          setTimeout(function(){try{
            if(window.__DSH_STARTUP_RUNNING__===true)return;
            var r=document.getElementById('dsh-startup-root');
            if(r&&r.parentNode)r.parentNode.removeChild(r);
            document.documentElement.classList.remove('dsu-lock');
            if(document.body)document.body.style.overflow='';
            window.__DSH_STARTUP_FAILED__=true;
          }catch(e){}},9000);
        }
      }catch(e){}})();
    </script>
    {!wide && (
      <header class="site-head">
        <div class="site-head-inner">
          <a class="wordmark" href="/">
            <span class="wm-dot" aria-hidden="true"></span>作品集
          </a>
          <nav class="site-nav" aria-label="主导航">
            {navItems.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>
    )}
    <div class:list={['page', { 'page-wide': wide }]}>
      <slot />
      <footer class="footer">
        <span>© {year} · 用 Astro + GitHub Pages 构建</span>
        <a class="footer-admin" href="https://portfolio-backend.3506328561.workers.dev/admin" target="_blank" rel="noopener">后台管理</a>
      </footer>
    </div>
  </body>
</html>

<style>
  /* —— 基础版式（组件级样式随 M1+ 各页面补齐，此处仅全局骨架）—— */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .page {
    flex: 1;
    /* width:100% + align-self 代替 margin:auto：auto 边距会覆盖 stretch 使 flex 项
       按内容 min-content 定宽，首页全幅横带（112vw）会因此撑出 375px 横滚 */
    width: 100%;
    align-self: center;
    min-width: 0;
    max-width: 1080px;
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
    display: flex;
    flex-direction: column;
  }
  /* —— 全局吸顶导航（wide 沉浸页自带导航，不渲染）—— */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .site-head-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--sp-2) var(--sp-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
    text-decoration: none;
  }
  .wm-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent-ink);
  }
  .site-nav {
    display: flex;
    gap: clamp(12px, 2.4vw, 24px);
  }
  .site-nav a {
    font-size: 0.9rem;
    color: var(--text-2);
    text-decoration: none;
    padding: 2px 0;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover {
    color: var(--accent-ink);
  }
  .site-nav a[aria-current='page'] {
    color: var(--accent-ink);
    font-weight: 500;
    border-bottom-color: var(--hl);
  }
  .page-wide {
    max-width: none;
    padding: 0;
  }
  .page-wide .footer {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
  }
  .footer {
    margin-top: auto;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
    color: var(--text-2);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .footer-admin {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.8rem;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: color 0.15s, border-color 0.15s;
  }
  .footer-admin:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
