---
// InkTrail —— 全局墨痕拖尾 + 点击荡开（Base.astro 全站接入）
// 配色走 tokens.css 的 --inktrail-head / --inktrail-tail（用户调参台定稿，纯装饰用途）
---

{/* 全屏画布：垫在内容层之下。pointer-events:none 是硬约束——
    全屏 fixed 元素一旦接收指针事件会吞掉整站链接点击 */}
<canvas class="inktrail" id="inktrail" aria-hidden="true"></canvas>

<style>
  .inktrail {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  (() => {
    const canvas = document.getElementById('inktrail');
    if (!canvas || !canvas.getContext) return;
    const ctx = canvas.getContext('2d');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TAU = Math.PI * 2;

    // —— 配色：从 tokens.css 读取（改色只动 tokens.css，组件零改动）——
    const rootCSS = getComputedStyle(document.documentElement);
    const hex2rgb = (h) => {
      const m = h.replace('#', '').match(/^([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i);
      return m ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)] : [0, 0, 0];
    };
    const token = (name, fbName) => {
      const v = rootCSS.getPropertyValue(name).trim() || rootCSS.getPropertyValue(fbName).trim();
      return hex2rgb(v);
    };
    const C_HEAD = token('--inktrail-head', '--accent');     // 头部色
    const C_TAIL = token('--inktrail-tail', '--accent-ink'); // 尾部色 / 涟漪环色
    const TRAIL = 420;             // 尾迹寿命（ms）
    const HEAD_R = 7;              // 拖尾头部半径（px）
    const TAIL_R = 0;              // 拖尾尾部半径（px，0 = 收尖）
    const HEAD_A = 0.32;           // 头部不透明度
    const GLOW = 0.05;             // 柔光倍率（×不透明度）
    const R1_R = 260, R1_W = 3;    // 外环：半径 / 线宽
    const R2_R = 190, R2_W = 2;    // 内环：半径 / 线宽
    const R_DELAY = 0.12;          // 双环延迟（秒）
    const WOB = 0.03;              // 涟漪扰动幅度

    let W = 0, H = 0;
    let trail = [];    // {x, y, t} 指针路径采样
    let ripples = [];  // {x, y, t0}
    let px = -9999, py = -9999, lx = -9999, ly = -9999;
    let raf = 0;

    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth;
      H = innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    addEventListener('pointermove', (e) => {
      px = e.clientX;
      py = e.clientY;
      wake();
    }, { passive: true });
    addEventListener('pointerdown', (e) => {
      // 必须取事件自身坐标：触屏落点时先触发 pointerdown（尚无 pointermove），
      // 用上次坐标会把涟漪生成到屏幕外；同时尾迹从落点重新起笔，避免拉一条横线
      px = e.clientX;
      py = e.clientY;
      lx = px;
      ly = py;
      ripples.push({ x: px, y: py, t0: performance.now() });
      wake();
    }, { passive: true });
    addEventListener('pointerleave', () => {
      px = -9999;
      py = -9999;
      trail = [];
      wake();
    });
    addEventListener('resize', () => {
      size();
    });

    const wake = () => {
      if (!raf && !calm) raf = requestAnimationFrame(frame);
    };

    // 单环涟漪：easeOutCubic 先快后慢的「荡开」，半径带微扰动避免太几何
    const ring = (x, y, age, alphaK, maxR, lw) => {
      if (age <= 0 || age > 1) return;
      const e = 1 - Math.pow(1 - age, 3);
      const r = maxR * e;
      ctx.strokeStyle = `rgba(${C_TAIL[0]},${C_TAIL[1]},${C_TAIL[2]},${(1 - age) * 0.4 * alphaK})`;
      ctx.lineWidth = lw * (1 - age * 0.7);
      ctx.beginPath();
      const N = 48;
      for (let i = 0; i <= N; i++) {
        const th = (i / N) * TAU;
        const rr = r * (1 + WOB * Math.sin(th * 3 + age * 6));
        const cx = x + Math.cos(th) * rr;
        const cy = y + Math.sin(th) * rr;
        i ? ctx.lineTo(cx, cy) : ctx.moveTo(cx, cy);
      }
      ctx.stroke();
    };

    const draw = (now) => {
      ctx.clearRect(0, 0, W, H);
      // —— 拖尾：头（亮、大）→ 尾（暗、收尖）渐隐 ——
      for (const p of trail) {
        const k = 1 - (now - p.t) / TRAIL;
        if (k <= 0) continue;
        const r = TAIL_R + HEAD_R * k * k;
        const a = HEAD_A * k;
        if (GLOW > 0) {
          ctx.fillStyle = `rgba(${C_HEAD[0]},${C_HEAD[1]},${C_HEAD[2]},${a * GLOW})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, r * 2.6, 0, TAU);
          ctx.fill();
        }
        const t2 = 1 - k;
        const cr = Math.round(C_HEAD[0] + (C_TAIL[0] - C_HEAD[0]) * t2);
        const cg = Math.round(C_HEAD[1] + (C_TAIL[1] - C_HEAD[1]) * t2);
        const cb = Math.round(C_HEAD[2] + (C_TAIL[2] - C_HEAD[2]) * t2);
        ctx.fillStyle = `rgba(${cr},${cg},${cb},${a})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, TAU);
        ctx.fill();
      }
      // —— 荡开：双环涟漪 + 中心墨点冲击 ——
      for (const rp of ripples) {
        const age = (now - rp.t0) / 1000;
        if (age > 1.1) continue;
        const ck = Math.max(0, 1 - age * 4);
        if (ck > 0) {
          ctx.fillStyle = `rgba(${C_TAIL[0]},${C_TAIL[1]},${C_TAIL[2]},${ck * 0.5})`;
          ctx.beginPath();
          ctx.arc(rp.x, rp.y, 6 + (1 - ck) * 26, 0, TAU);
          ctx.fill();
        }
        ring(rp.x, rp.y, age, 1, R1_R, R1_W);
        ring(rp.x, rp.y, age - R_DELAY, 0.55, R2_R, R2_W);
      }
    };

    const frame = (now) => {
      trail = trail.filter((p) => now - p.t < TRAIL);
      // 指针位移采样：沿路径插值补点（快划不断），静止即停止入队
      if (px >= 0) {
        if (lx < 0) {
          trail.push({ x: px, y: py, t: now });
          lx = px;
          ly = py;
        } else {
          const dx = px - lx;
          const dy = py - ly;
          const dist = Math.hypot(dx, dy);
          if (dist > 0.6) {
            const steps = Math.min(24, Math.max(1, Math.ceil(dist / 7)));
            for (let i = 1; i <= steps; i++) {
              trail.push({ x: lx + (dx * i) / steps, y: ly + (dy * i) / steps, t: now });
            }
            lx = px;
            ly = py;
          }
        }
      }
      if (trail.length > 600) trail.splice(0, trail.length - 600);
      ripples = ripples.filter((r) => now - r.t0 < 1100);
      draw(now);
      raf = trail.length || ripples.length ? requestAnimationFrame(frame) : 0;
    };

    size();
    window.__inktrail = true; // E2E 就绪信号
  })();
</script>
