---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// 首页统计口径与各列表页一致：dev 含草稿，生产仅 published
const isDev = import.meta.env.DEV;

const allNotes = await getCollection('notes');
const visibleNotes = isDev ? allNotes : allNotes.filter((n) => n.data.status === 'published');
const noteCount = visibleNotes.length;
const catCount = new Set(visibleNotes.map((n) => n.data.category)).size;

const allProjects = await getCollection('projects');
const visibleProjects = isDev ? allProjects : allProjects.filter((p) => p.data.status === 'published');
const projectCount = visibleProjects.length;
const projectCatCount = new Set(visibleProjects.map((p) => p.data.category)).size;

const galleryEntry = await getCollection('gallery');
const galleryItems = galleryEntry[0]?.data.items ?? [];
const visibleGallery = isDev ? galleryItems : galleryItems.filter((i) => i.status === 'published');
const galleryCount = visibleGallery.length;

const allResources = await getCollection('resources');
const visibleResources = isDev ? allResources : allResources.filter((r) => r.data.status === 'published');
const resourceCount = visibleResources.length;
const resourceKindCount = new Set(visibleResources.map((r) => r.data.kind)).size;

// 首屏/入口大图：按 slug 精选已发布画廊作品；若作品被下架则跳过（不空窗、不破图）
const pickBySlug = (...slugs: string[]) =>
  slugs
    .map((s) => visibleGallery.find((i) => i.slug === s))
    .filter((it): it is NonNullable<typeof it> => Boolean(it));
const heroImages = pickBySlug('20261031-sakura-torii-01', '20261031-starry-train-01', '20261031-moon-gate-dusk-01');
const entryImages = pickBySlug('20261031-wall-e-stars-01', '20261031-harbor-studio-01', '20261031-dusk-portrait-01', '20261031-retro-bedroom-01');
const imgUrl = (it: { src: string }) => `/images/gallery/${it.src}`;
---

<Base title="作品集 · 个人档案" description="个人作品集：笔记档案、项目展示与艺术画廊" wide>
  <!-- ① 首屏：全屏画境——3 张大图 15s 交叉淡入 + 滚动视差（图慢移 / 标题上移淡出） -->
  <section class="hero">
    {heroImages.length > 0 && (
      <div class="hero-bg" id="heroBg">
        {heroImages.map((it, i) => (
          <img
            class="img"
            src={imgUrl(it)}
            alt=""
            width="1920"
            height="1080"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        ))}
      </div>
    )}
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-top">
      <span>PORTFOLIO · 个人作品集</span>
      <span>EST. 2026</span>
    </div>

    <div class="hero-center" id="heroCenter">
      <p class="kicker-line">笔记档案 · 项目展示 · 艺术画廊</p>
      <h1 class="hero-title">你好，这里是我的<br /><span class="mark">作品集</span>。</h1>
      <p class="hero-sub">持续归档中 —— 每一篇笔记、每一个项目、每一张画，都留在这里</p>
    </div>

    <div class="hero-bottom">
      <a class="about-link" href="/about/">关于这个站 →</a>
      <span class="scroll-cue" aria-hidden="true">
        往下滚
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M12 4v15M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </section>

  <!-- ② 滚动横带：墨色斜切 + 双色交替（112vw + 外层裁剪，375px 不横滚） -->
  <div class="band-wrap" aria-hidden="true">
    <div class="band">
      <div class="band-track">
        <span>笔记 · 项目 · 画廊 · 持续归档中 ·&nbsp;</span><span>笔记 · 项目 · 画廊 · 持续归档中 ·&nbsp;</span>
      </div>
    </div>
  </div>

  <!-- ③ 三入口：大图卡（hover 放大 + 箭头点亮），计数与列表页同口径 -->
  <section class="entries">
    <div class="entries-inner">
      <p class="sec-label">WHAT'S INSIDE</p>
      <h2 class="sec-title">里面有什么</h2>
      <div class="entry-grid">
        <a class="entry-card" href="/notes/">
          {entryImages[0] && <img src={imgUrl(entryImages[0])} alt="" width="1920" height="1080" loading="lazy" decoding="async" />}
          <span class="entry-arrow" aria-hidden="true">→</span>
          <span class="entry-body">
            <span class="entry-idx">01</span>
            <span class="entry-name">笔记档案</span>
            <span class="entry-meta">{noteCount} 篇 · {catCount} 个分类 · AI / FastAPI / Python / 智能客服</span>
          </span>
        </a>
        <a class="entry-card" href="/projects/">
          {entryImages[1] && <img src={imgUrl(entryImages[1])} alt="" width="1920" height="1080" loading="lazy" decoding="async" />}
          <span class="entry-arrow" aria-hidden="true">→</span>
          <span class="entry-body">
            <span class="entry-idx">02</span>
            <span class="entry-name">项目展示</span>
            <span class="entry-meta">{projectCount} 个 · {projectCatCount} 个分类 · 智能体 / 全栈 / 工具</span>
          </span>
        </a>
        <a class="entry-card" href="/gallery/">
          {entryImages[2] && <img src={imgUrl(entryImages[2])} alt="" width="1920" height="1080" loading="lazy" decoding="async" />}
          <span class="entry-arrow" aria-hidden="true">→</span>
          <span class="entry-body">
            <span class="entry-idx">03</span>
            <span class="entry-name">艺术画廊</span>
            <span class="entry-meta">{galleryCount} 张 · 艺术收藏 · 持续归档中</span>
          </span>
        </a>
        <a class="entry-card" href="/resources/">
          {entryImages[3] && <img src={imgUrl(entryImages[3])} alt="" width="1920" height="1080" loading="lazy" decoding="async" />}
          <span class="entry-arrow" aria-hidden="true">→</span>
          <span class="entry-body">
            <span class="entry-idx">04</span>
            <span class="entry-name">资源库</span>
            <span class="entry-meta">{resourceCount} 个 · {resourceKindCount} 种类型 · 持续收录中</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ④ 关于区块：/about/ 页内容块原样迁入首页末尾（footer 之前）——
       宽屏页（.page-wide padding:0）里外层全宽承托纵向留白、内层 720 居中，
       与 entries 同款「外层全宽 + 内层 max-width」防 flex 子项收缩 -->
  <section class="about-section">
    <article class="about">
      <h1>关于</h1>
      <p>
        这里是我的个人作品集——一个把<strong>学过、做过、收藏</strong>的东西都归档下来的地方。
        学过的内容如果只留在聊天记录和本地文件夹里，等于没学；这个站就是我的第二大脑。
      </p>

      <h2>我在做什么</h2>
      <p>
        平时写后端：FastAPI、Python、HTTP 基础；业余时间大半花在 AI 应用上——智能体、RAG、提示工程，
        以及几个从想法走到可运行原型的小项目（智能客服、校园助手、通用 RAG 等）。
        笔记按分类归档，项目留下档案，喜欢的画有个格子。
      </p>

      <h2>这个站点怎么运转</h2>
      <ul>
        <li>静态站点：Astro 5 构建，GitHub Pages 托管，Pagefind 提供站内搜索；</li>
        <li>彩铅笔感亮主题：纸感底色 + 手绘色铅笔气质，全站统一视觉；</li>
        <li>两条上传通道：对 AI 说「帮我把这 xxx 上传到我的作品集」（主通道），或使用网页后台自助上传（辅通道）；</li>
        <li>CI 双门禁：内容契约预检 + 构建校验，任一失败即中止，线上保持上一可用版本；</li>
        <li>画廊：个人艺术收藏，含 AI 生成画作。</li>
      </ul>

      <h2>找到我</h2>
      <p>
        GitHub：<a href="https://github.com/shanren4002" target="_blank" rel="noopener">github.com/shanren4002</a>
      </p>
    </article>
  </section>
</Base>

<script>
  // 首屏滚动视差：rAF 节流 + passive；reduced-motion 直接跳过（CSS 侧交叉淡入/跑马灯同步降级）
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bg = document.getElementById('heroBg');
  const center = document.getElementById('heroCenter');
  if (!calm && bg && center) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        const h = window.innerHeight;
        const p = Math.min(y / h, 1);
        bg.style.transform = `translateY(${y * 0.28}px) scale(${1 + p * 0.12})`;
        center.style.transform = `translateY(${y * -0.16}px)`;
        center.style.opacity = String(Math.max(0, 1 - p * 1.1));
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  /* —— ① 首屏：全屏画境 —— */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-4) clamp(20px, 5vw, 64px) var(--sp-5);
    color: var(--on-overlay);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: -8% 0 0 0;
    z-index: -2;
    will-change: transform;
  }
  .hero-bg .img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hero-fade 15s infinite;
  }
  .hero-bg .img:nth-child(2) {
    animation-delay: 5s;
  }
  .hero-bg .img:nth-child(3) {
    animation-delay: 10s;
  }
  @keyframes hero-fade {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    30% {
      opacity: 1;
    }
    34% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      var(--scrim-hero-top) 0%,
      var(--scrim-hero-mid) 42%,
      var(--scrim-hero-low) 72%,
      var(--scrim-hero-fade) 100%
    );
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    opacity: 0.85;
  }
  .hero-center {
    max-width: 1100px;
    padding: var(--sp-5) 0;
    will-change: transform, opacity;
  }
  .kicker-line {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.3em;
    margin-bottom: 22px;
    opacity: 0.9;
  }
  .kicker-line::before {
    content: '';
    width: 44px;
    height: 2px;
    background: var(--hl);
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.6rem, 7.5vw, 5.6rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 24px var(--scrim-hero-mid);
  }
  /* 手绘马克笔高亮（光斑黄，上压松烟墨 7.4:1） */
  .mark {
    position: relative;
    z-index: 0;
    display: inline-block;
    padding: 0 0.12em;
  }
  .mark::before {
    content: '';
    position: absolute;
    inset: 12% -0.04em 8%;
    background: var(--hl);
    transform: rotate(-1.2deg);
    border-radius: 0.1em;
    z-index: -1;
  }
  .hero-sub {
    margin: 20px 0 0;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    letter-spacing: 0.08em;
    opacity: 0.92;
  }
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-3);
  }
  /* 底部 scrim 已化入纸色，文字用深色 token（accent-ink on bg = 5.4:1） */
  .about-link {
    font-size: 0.95rem;
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 4px;
    transition: opacity 0.2s;
  }
  .about-link:hover {
    opacity: 0.75;
  }
  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: var(--text-2);
  }
  .scroll-cue svg {
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* —— ② 滚动横带 —— */
  .band-wrap {
    overflow: hidden;
    padding: clamp(30px, 5vh, 46px) 0;
  }
  .band {
    width: 112vw;
    margin-left: -6vw;
    background: var(--text);
    transform: rotate(-1.6deg);
    padding: clamp(12px, 2vh, 16px) 0;
  }
  .band-track {
    display: flex;
    width: max-content;
    animation: marquee 22s linear infinite;
  }
  .band-track span {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    letter-spacing: 0.14em;
    color: var(--hl);
    white-space: nowrap;
    padding-right: 12px;
  }
  .band-track span:nth-child(2) {
    color: var(--bg);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* —— ③ 三入口大图卡 —— */
  /* 注意：.entries 是 .page（flex column）的直接子项，不能加 margin:auto——
     auto 边距会覆盖 stretch 使区块按内容收缩（ Base.astro 同款陷阱），
     故外层全宽承托纵向留白，内层 entries-inner 负责 1280 居中 */
  .entries {
    padding: clamp(56px, 9vh, 70px) 0 clamp(64px, 10vh, 90px);
  }
  .entries-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
  }
  .sec-label {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.28em;
    color: var(--accent-ink);
  }
  .sec-title {
    margin: 0 0 clamp(32px, 5vh, 44px);
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    font-weight: 600;
  }
  .entry-grid {
    display: grid;
    /* 2026-11-09：资源库开区后为 4 卡 2×2（3 列会让第 4 张落单）；≤600px 仍单列 */
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .entry-card {
    position: relative;
    display: block;
    height: 460px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--on-overlay);
    isolation: isolate;
  }
  .entry-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .entry-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--scrim-card-top) 30%, var(--scrim-card-bottom) 100%);
  }
  .entry-card:hover img {
    transform: scale(1.09);
  }
  .entry-body {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 24px;
  }
  .entry-idx {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--on-overlay-2);
    margin-bottom: 8px;
  }
  .entry-name {
    display: block;
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    font-weight: 600;
  }
  .entry-meta {
    display: block;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--on-overlay-3);
  }
  .entry-arrow {
    position: absolute;
    top: 22px;
    right: 24px;
    width: 42px;
    height: 42px;
    border: 1.5px solid var(--on-overlay-3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .entry-card:hover .entry-arrow,
  .entry-card:focus-visible .entry-arrow {
    background: var(--hl);
    color: var(--text);
    border-color: var(--hl);
  }
  .entry-card:focus-visible {
    outline: 2px solid var(--hl);
    outline-offset: 2px;
  }

  /* —— ④ 关于区块（/about/ 内容块原样迁入；宽屏页外层全宽承托 + 内层 720 居中）—— */
  .about-section {
    padding: clamp(56px, 9vh, 70px) 0 clamp(40px, 6vh, 56px);
  }
  .about {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
  }
  .about h1 {
    border-bottom: 2px solid var(--line);
    padding-bottom: var(--sp-2);
  }
  .about a {
    color: var(--accent-ink);
  }

  @media (max-width: 860px) {
    .entry-grid {
      grid-template-columns: 1fr;
    }
    .entry-card {
      height: 340px;
    }
    .hero {
      min-height: 520px;
    }
  }
  @media (max-width: 560px) {
    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-2);
    }
    .entry-body {
      left: 20px;
      right: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg .img {
      animation: none;
    }
    .hero-bg .img:first-child {
      opacity: 1;
    }
    .band-track,
    .scroll-cue svg {
      animation: none;
    }
    .entry-card img {
      transition: none;
    }
  }
</style>
