---
import Base from '../layouts/Base.astro';
---

<Base title="404 · 这一页走丢了" description="页面不存在或已移动——从导航重新出发吧">
  <article class="notfound">
    <p class="nf-kicker" aria-hidden="true">404</p>
    <h1>这一页走丢了</h1>
    <p class="nf-lead">
      你要找的内容不在这里，或者已经搬走了。作品集不大，从下面重新出发就好。
    </p>
    <nav class="nf-links" aria-label="回退导航">
      <a href="/">首页</a>
      <a href="/notes/">笔记档案</a>
      <a href="/projects/">项目展示</a>
      <a href="/gallery/">艺术画廊</a>
      <a href="/about/">关于</a>
    </nav>
  </article>
</Base>

<style>
  .notfound {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--sp-6) 0 var(--sp-5);
    text-align: center;
  }
  .nf-kicker {
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 700;
    line-height: 1;
    color: var(--hl);
    margin: 0 0 var(--sp-2);
    letter-spacing: 0.08em;
  }
  .notfound h1 {
    border-bottom: none;
    margin-bottom: var(--sp-3);
  }
  .nf-lead {
    color: var(--text-2);
    max-width: 34em;
    margin: 0 auto var(--sp-4);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2);
  }
  .nf-links a {
    display: inline-block;
    padding: 6px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent-ink);
    text-decoration: none;
    font-size: 0.9rem;
    background: var(--surface);
    transition: border-color 0.15s, color 0.15s;
  }
  .nf-links a:hover {
    border-color: var(--accent);
  }
</style>
