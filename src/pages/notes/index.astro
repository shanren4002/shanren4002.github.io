---
/* 笔记列表页 · 版二「词云星图」（2026-11-05 用户选定定稿）
 * 设计样板：.workbuddy/qa/mockups/notes-r2-2-constellation.html（非最终实现角标版）
 * 回滚档案：.workbuddy/qa/rollback/README.md（旧版 SHA 11def15 + 旧文件备份 + 一键回滚命令） */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// 生产环境只展示 published；dev 模式展示全部（草稿带徽章，供本地抽查）
const all = await getCollection('notes');
type NoteEntry = (typeof all)[number];
const isDev = import.meta.env.DEV;
const notes = isDev ? all : all.filter((n) => n.data.status === 'published');
const sorted = [...notes].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// —— 分类（按篇数降序）——仅用于条目分类色点映射（装饰，循环 4 色）——
const catCount = new Map<string, number>();
for (const n of sorted) catCount.set(n.data.category, (catCount.get(n.data.category) ?? 0) + 1);
const categories = [...catCount.entries()].sort((a, b) => b[1] - a[1]);
const catCi = new Map(categories.map(([cat], i) => [cat, i % 4]));

// —— 词云：标签频次（降序，同频次按名称）；字号分 5 档（xl≥8 / lg≥5 / md≥3 / sm=2 / xs=1）——
const tagCount = new Map<string, number>();
for (const n of sorted) for (const t of n.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN'));
const tierOf = (n: number) => (n >= 8 ? 'xl' : n >= 5 ? 'lg' : n >= 3 ? 'md' : n === 2 ? 'sm' : 'xs');

// —— 时间轴：日期分组（倒序）+ 月界标记；日期组左右交错（河流式）——
const isoDate = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const md = (d: Date | string) =>
  typeof d === 'string' ? d.slice(5, 7) + '.' + d.slice(8, 10) : `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const yy = (d: Date | string) => (typeof d === 'string' ? d.slice(2, 4) : String(d.getFullYear()).slice(2));

const byDate = new Map<string, NoteEntry[]>();
for (const n of sorted) {
  const key = isoDate(n.data.date);
  const list = byDate.get(key) ?? [];
  list.push(n);
  byDate.set(key, list);
}
const dayEntries = [...byDate.entries()].sort((a, b) => (a[0] < b[0] ? 1 : -1));

const monthMap = new Map<string, { key: string; label: string; count: number }>();
for (const [date, items] of dayEntries) {
  const mk = date.slice(0, 7);
  const m = monthMap.get(mk) ?? { key: mk, label: `${mk.slice(0, 4)} 年 ${Number(mk.slice(5, 7))} 月`, count: 0 };
  m.count += items.length;
  monthMap.set(mk, m);
}

type TlNode =
  | { type: 'month'; key: string; label: string; count: number }
  | { type: 'day'; date: string; month: string; items: NoteEntry[]; pos: 'l' | 'r'; hot: boolean };
const tlNodes: TlNode[] = [];
let dayIdx = 0;
for (const [date, items] of dayEntries) {
  const mk = date.slice(0, 7);
  if (!tlNodes.some((x) => x.type === 'month' && x.key === mk)) {
    tlNodes.push({ type: 'month', ...monthMap.get(mk)! });
  }
  tlNodes.push({ type: 'day', date, month: mk, items, pos: dayIdx % 2 === 0 ? 'l' : 'r', hot: items.length >= 3 });
  dayIdx++;
}

const latest = sorted[0]?.data.date;
---

<Base title="笔记" description="学习笔记归档：AI / FastAPI / Python / HTTP / 智能客服">
  <section class="notes-index">
    <header class="page-head">
      <p class="head-kicker">ARCHIVE · 学习归档</p>
      <h1 class="head-title"><span class="hl">笔记</span></h1>
      <div class="head-stats">
        <div class="stat">
          <span class="stat-num">{sorted.length}</span>
          <span class="stat-label">篇笔记</span>
        </div>
        <div class="stat">
          <span class="stat-num">{categories.length}</span>
          <span class="stat-label">个分类</span>
        </div>
        {latest && (
          <div class="stat">
            <span class="stat-date stat-num">{md(latest)}</span>
            <span class="stat-label">最近更新 · {yy(latest)}</span>
          </div>
        )}
      </div>
      {isDev && <p class="dev-hint">dev 预览：含草稿，发布后仅可见 published</p>}
    </header>

    {sorted.length === 0 ? (
      <div class="empty">
        <p>还没有已发布的笔记。</p>
        <p class="empty-sub">对 AI 说一句「帮我把这 xxx 上传到我的作品集」，或等本地抽查完成后发布。</p>
      </div>
    ) : (
      <>
        {/* —— 词云 hero：独占首屏剩余空间（高度由紧随其后的内联脚本按实测顶部设定）—— */}
        <section class="cx-zone" data-reveal aria-label="标签词云，点按过滤">
          <p class="cx-kicker">TAG CLOUD · {tags.length} 个标签 · 字号即频次</p>
          <div class="cx-cloud">
            {tags.map(([name, count]) => (
              <button type="button" class:list={['tc', `tc-${tierOf(count)}`]} data-tag={name} aria-pressed="false">
                {name}
              </button>
            ))}
          </div>
          <p class="cx-focus">
            <button type="button" class="cw-all" id="f-all">全部<span class="tc-n">{sorted.length}</span></button>
            <span id="f-focus">当前聚焦 · 全部 {sorted.length} 篇</span>
          </p>
          <p class="cx-scroll" aria-hidden="true">时间轴在下方 ↓</p>
        </section>
        <script is:inline>
          /* hero 精确填充首屏剩余空间：按 zone 文档顶实测（导航/页头/间距全计入），resize 重算。
             内联经典脚本置于 zone 之后——HTML 解析期执行，先于首帧绘制，避免撑高产生的布局位移 */
          (function () {
            var zone = document.querySelector('.cx-zone');
            if (!zone) return;
            function fit() {
              var top = zone.getBoundingClientRect().top + scrollY;
              zone.style.minHeight = Math.max(300, innerHeight - top) + 'px';
            }
            fit();
            addEventListener('resize', fit);
            addEventListener('load', fit);
          })();
        </script>

        {/* —— Pagefind 站内搜索（M4）：位于 hero 之下、时间轴之上；搜索时隐藏浏览区 —— */}
        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.8-3.8" />
          </svg>
          <input
            id="note-search"
            type="search"
            placeholder="搜索标题或正文…"
            aria-label="搜索笔记"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" id="search-clear" class="search-clear" hidden aria-label="清空搜索">×</button>
        </div>
        <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
        <div class="search-results" id="search-results" data-pf-base={import.meta.env.BASE_URL} hidden></div>

        {/* —— 河流式时间轴：脊柱居中，日期组交错左右 —— */}
        <section class="cx-axis-zone">
          <h2 class="cx-axis-h">时间轴 · {dayEntries.length} 个日期节点<span class="cx-axis-n" id="f-count">{sorted.length} 篇</span></h2>
          <div class="tl tl-river">
            {tlNodes.map((node) =>
              node.type === 'month' ? (
                <div class="tl-month tl-month-r" data-reveal data-month={node.key}>
                  <span class="tl-month-t">{node.label}</span>
                  <span class="tl-month-n">{node.count} 篇</span>
                </div>
              ) : (
                <div
                  class:list={['tl-day', 'tl-day-r', node.pos === 'l' ? 'pos-l' : 'pos-r']}
                  data-reveal
                  data-n={node.items.length}
                  data-month={node.month}
                  data-hot={node.hot ? true : undefined}
                >
                  <div class="tl-day-head">
                    <time datetime={node.date}>{yy(node.date)}.{md(node.date)}</time>
                    <span class="tl-day-n">{node.items.length} 篇</span>
                  </div>
                  {node.items.map((n) => (
                    <a class="tl-item" href={`/notes/${n.data.slug}/`} data-tags={n.data.tags.map((t) => t.toLowerCase()).join('|')}>
                      <span class="tl-item-t">{n.data.title}</span>
                      <p class="tl-item-s">{n.data.summary}</p>
                      <span class="tl-item-m">
                        <span class="cat-dot" data-ci={catCi.get(n.data.category) ?? 0} aria-hidden="true"></span>
                        {n.data.category} · {md(n.data.date)}
                        {n.data.status === 'draft' && isDev && <span class="badge-draft">草稿</span>}
                      </span>
                    </a>
                  ))}
                </div>
              ),
            )}
          </div>
        </section>
      </>
    )}
  </section>
</Base>

<script>
  // —— Pagefind 站内搜索（M4）：按需加载索引包，区分标题命中/正文命中 ——
  const input = document.getElementById('note-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results');
  const browseEl = document.querySelector('.notes-index');

  if (input && statusEl && resultsEl && browseEl) {
    let pf: any = null;
    let loading: Promise<any> | null = null;
    let timer: number | undefined;
    let seq = 0;

    const ensurePagefind = () => {
      if (pf) return Promise.resolve(pf);
      if (!loading) {
        // 运行时拼路径（打包器不可静态分析）；索引包仅在首次交互时加载
        const base = resultsEl.dataset.pfBase || '/';
        loading = import(base + 'pagefind/pagefind.js')
          .then((mod: any) => mod?.default ?? mod)
          .catch(() => null);
      }
      return loading;
    };

    const escapeText = (s: string) =>
      String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
      );

    const setSearching = (on: boolean) => {
      browseEl!.classList.toggle('searching', on);
      resultsEl.hidden = !on;
      if (clearBtn) clearBtn.hidden = !on;
    };

    const reset = () => {
      seq += 1;
      input.value = '';
      setSearching(false);
      statusEl.textContent = '';
      resultsEl.innerHTML = '';
    };

    clearBtn?.addEventListener('click', reset);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') reset();
    });

    input.addEventListener(
      'input',
      () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => void runSearch(input.value), 150);
      },
    );

    async function runSearch(q: string) {
      const query = q.trim();
      if (!query) {
        reset();
        return;
      }
      const my = ++seq;
      setSearching(true);
      if (!pf) statusEl.textContent = '索引加载中…';

      const p = await ensurePagefind();
      if (my !== seq) return;
      if (!p) {
        statusEl.textContent = '搜索索引不可用：dev 模式需先 pnpm build（线上不受影响）';
        resultsEl.innerHTML = '';
        return;
      }

      const t0 = performance.now();
      let search: any;
      try {
        search = await p.search(query);
      } catch {
        if (my !== seq) return;
        statusEl.textContent = '搜索出错了，请重试';
        resultsEl.innerHTML = '';
        return;
      }
      if (my !== seq) return;

      const items: any[] = [];
      for (const r of search?.results ?? []) {
        items.push(await r.data());
      }
      if (my !== seq) return;

      const ms = Math.max(1, Math.round(performance.now() - t0));
      if (items.length === 0) {
        statusEl.textContent = `没有找到与「${query}」相关的笔记`;
        resultsEl.innerHTML = '';
        return;
      }

      statusEl.textContent = `找到 ${items.length} 篇 · ${ms}ms`;
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      resultsEl.innerHTML = items
        .map((d: any) => {
          const metaTitle = String(d.meta?.title ?? '');
          const titleHit = words.some((w) => metaTitle.toLowerCase().includes(w));
          const title = escapeText(metaTitle || d.url || '');
          const cat = d.meta?.category ? escapeText(d.meta.category) : '';
          return `<a class="search-hit" href="${escapeText(d.url ?? '#')}">
            <span class="hit-badge${titleHit ? ' title' : ''}">${titleHit ? '标题命中' : '正文命中'}</span>
            <span class="hit-title">${title}</span>
            ${cat ? `<span class="hit-cat">${cat}</span>` : ''}
            <p class="hit-excerpt">${d.excerpt ?? ''}</p>
          </a>`;
        })
        .join('');
    }
  }

  // —— 词云过滤：条目级（点词只显示命中条目；空日期组/空月界自动收起）——
  const cloudBtns = document.querySelectorAll<HTMLButtonElement>('.tc[data-tag]');
  const itemEls = Array.prototype.slice.call(document.querySelectorAll<HTMLElement>('.tl-item[data-tags]'));
  const dayEls = Array.prototype.slice.call(document.querySelectorAll<HTMLElement>('.tl-day[data-month]'));
  const monthEls = Array.prototype.slice.call(document.querySelectorAll<HTMLElement>('.tl-month[data-month]'));
  const countEl = document.getElementById('f-count');
  const focusEl = document.getElementById('f-focus');
  const allBtn = document.getElementById('f-all');
  const totalN = itemEls.length;
  function applyFilter(tag: string) {
    const key = tag ? tag.toLowerCase() : '';
    let n = 0;
    itemEls.forEach((it: HTMLElement) => {
      const show = !key || String(it.dataset.tags || '').split('|').indexOf(key) !== -1;
      it.hidden = !show;
      if (show) n++;
    });
    dayEls.forEach((d: HTMLElement) => {
      d.hidden = !d.querySelector('.tl-item:not([hidden])');
    });
    monthEls.forEach((m: HTMLElement) => {
      m.hidden = !dayEls.some((d: HTMLElement) => !d.hidden && d.dataset.month === m.dataset.month);
    });
    cloudBtns.forEach((b: HTMLButtonElement) => {
      const on = b.dataset.tag === tag;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    if (countEl) countEl.textContent = n + ' 篇';
    if (focusEl) focusEl.textContent = tag ? '当前聚焦 · ' + tag + ' · ' + n + ' 篇' : '当前聚焦 · 全部 ' + totalN + ' 篇';
  }
  cloudBtns.forEach((b: HTMLButtonElement) => {
    b.addEventListener('click', () => {
      applyFilter(b.classList.contains('on') ? '' : (b.dataset.tag ?? ''));
    });
  });
  allBtn?.addEventListener('click', () => applyFilter(''));

  // —— 滚动进入动画（无 JS 时全部可见；reduced-motion 走 CSS 降级）——
  document.documentElement.classList.add('js');
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -36px 0px' },
    );
    revealTargets.forEach((el) => io.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add('in'));
  }
</script>

<style>
  .notes-index {
    /* 顶距让页头呼吸；hero 区高度由内联脚本按首屏剩余空间精确设定 */
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    padding: var(--sp-2) 0 0;
  }

  /* —— 页头：编辑式大标题 + 三联数据条 —— */
  .page-head {
    margin-bottom: var(--sp-4);
  }
  .head-kicker {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--accent-ink);
  }
  .head-title {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 600;
    line-height: 1.1;
  }
  /* 光斑黄 marker（与首页同一语言） */
  .hl {
    position: relative;
    z-index: 0;
    display: inline-block;
    padding: 0 0.1em;
  }
  .hl::before {
    content: '';
    position: absolute;
    inset: 14% -0.04em 10%;
    background: var(--hl);
    transform: rotate(-1deg);
    border-radius: 0.14em;
    z-index: -1;
  }
  /* 数据条：mono 大数字 + 小标签 + 短黄线 */
  .head-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-5);
    margin-top: var(--sp-4);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-num {
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
  }
  .stat-num::after {
    content: '';
    display: block;
    width: 26px;
    height: 3px;
    margin-top: 7px;
    background: var(--hl);
    border-radius: 2px;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--text-2);
    letter-spacing: 0.04em;
  }
  .stat-date {
    color: var(--accent-ink);
  }
  .dev-hint {
    margin: var(--sp-3) 0 0;
    font-size: 0.85rem;
    color: var(--accent-ink);
  }

  /* —— 滚动显现（html.js 下初始隐藏；reduced-motion 直接可见）—— */
  html.js [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
  }
  html.js [data-reveal].in {
    opacity: 1;
    transform: none;
    transition: opacity 700ms var(--ease) var(--d, 0ms), transform 700ms var(--ease) var(--d, 0ms);
  }

  /* —— 词云 hero：独占首屏剩余空间 —— */
  .cx-zone {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--sp-3) 0 var(--sp-4);
  }
  .cx-kicker {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.22em;
    color: var(--text-2);
  }
  .cx-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 5px 16px;
    max-width: 860px;
    padding: 6px 0;
  }
  .cx-focus {
    margin: var(--sp-3) 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
  }
  .cx-scroll {
    margin: var(--sp-3) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--text-2);
    animation: cx-bob 2.4s var(--ease) infinite;
  }
  @keyframes cx-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  /* —— 词云 chip（字号即频次，5 档）—— */
  .tc {
    font: inherit;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text);
    padding: 2px 7px;
    border-radius: 8px;
    line-height: 1.45;
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    white-space: nowrap;
    transition: color 200ms var(--ease), background-color 200ms var(--ease), transform 200ms var(--ease);
  }
  .cx-cloud .tc {
    padding: 3px 9px;
  }
  .cx-cloud .tc:hover {
    transform: translateY(-3px) scale(1.04);
  }
  .tc:hover {
    color: var(--accent-ink);
    background: var(--surface);
  }
  .tc:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 1px;
  }
  .tc.on {
    background: var(--tag-bg);
    color: var(--text);
  }
  .tc-n {
    font-family: var(--font-mono);
    font-size: 0.62em;
    color: var(--text-2);
  }
  .tc.on .tc-n {
    color: var(--text);
  }
  .cx-cloud .tc-xs {
    font-size: 0.92rem;
  }
  .cx-cloud .tc-sm {
    font-size: 1.12rem;
  }
  .cx-cloud .tc-md {
    font-size: 1.4rem;
    font-weight: 500;
  }
  .cx-cloud .tc-lg {
    font-size: 1.8rem;
    font-weight: 600;
  }
  .cx-cloud .tc-xl {
    font-size: 2.3rem;
    font-weight: 600;
  }
  .cw-all {
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 14px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    transition: border-color 200ms var(--ease), color 200ms var(--ease);
  }
