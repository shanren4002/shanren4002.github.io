---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// 生产环境只展示 published；dev 模式展示全部（草稿带徽章，供本地抽查）
const all = await getCollection('notes');
const isDev = import.meta.env.DEV;
const notes = isDev ? all : all.filter((n) => n.data.status === 'published');
const sorted = [...notes].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 按分类分组（分类按笔记数降序，多的在前）
const byCategory = new Map<string, typeof sorted>();
for (const n of sorted) {
  const list = byCategory.get(n.data.category) ?? [];
  list.push(n);
  byCategory.set(n.data.category, list);
}
const categories = [...byCategory.entries()].sort((a, b) => b[1].length - a[1].length);

// 编辑排版：pinned 优先上大卡；否则每分类最新一篇（分类 ≥3 篇时）上大卡
const featuredSlugs = new Set<string>();
for (const [, list] of categories) {
  const pinned = list.filter((n) => n.data.pinned);
  if (pinned.length > 0) {
    pinned.forEach((n) => featuredSlugs.add(n.data.slug));
  } else if (list.length >= 3) {
    featuredSlugs.add(list[0].data.slug);
  }
}

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const idx = (i: number) => String(i + 1).padStart(2, '0');
---

<Base title="笔记" description="学习笔记归档：AI / FastAPI / Python / HTTP / 智能客服">
  <section class="notes-index">
    <header class="page-head">
      <p class="head-kicker">ARCHIVE · 学习归档</p>
      <h1 class="head-title"><span class="hl">笔记</span></h1>
      <p class="head-meta">
        <span class="stat-num">{sorted.length}</span> 篇 · <span class="stat-num">{categories.length}</span> 个分类
        {isDev && <span class="dev-hint">（dev 预览：含草稿，发布后仅可见 published）</span>}
      </p>
    </header>

    {sorted.length === 0 ? (
      <div class="empty">
        <p>还没有已发布的笔记。</p>
        <p class="empty-sub">对 AI 说一句「帮我把这 xxx 上传到我的作品集」，或等本地抽查完成后发布。</p>
      </div>
    ) : (
      <div class="cat-jump">
        {categories.map(([cat, list], i) => (
          <a href={`#cat-${encodeURIComponent(cat)}`}>
            <span class="jump-index">{idx(i)}</span>{cat}
            <span class="jump-count">{list.length}</span>
          </a>
        ))}
      </div>
    )}

    {categories.map(([cat, list], i) => (
      <section class="cat-section" id={`cat-${encodeURIComponent(cat)}`}>
        <h2 class="cat-head">
          <span class="cat-index">{idx(i)}</span>
          <span class="cat-name">{cat}</span>
          <span class="cat-count">{list.length} 篇</span>
        </h2>
        <div class="note-list" data-pagefind-body>
          {list.map((n) => (
            <article class:list={['note-card', { featured: featuredSlugs.has(n.data.slug) }]}>
              <div class="note-meta">
                <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
                {featuredSlugs.has(n.data.slug) && <span class="badge-new">最新</span>}
                {n.data.status === 'draft' && isDev && <span class="badge-draft">草稿</span>}
              </div>
              <h3><a href={`/notes/${n.data.slug}/`}>{n.data.title}</a></h3>
              <p class="note-summary">{n.data.summary}</p>
              {n.data.tags.length > 0 && (
                <div class="tag-row">
                  {n.data.tags.map((t) => <span class="tag">#{t}</span>)}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</Base>

<style>
  .notes-index {
    padding: var(--sp-5) 0;
  }

  /* —— 页头：编辑式大标题 + 大数字统计 —— */
  .page-head {
    margin-bottom: var(--sp-5);
  }
  .head-kicker {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--accent-ink);
  }
  .head-title {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 600;
    line-height: 1.1;
  }
  /* 光斑黄 marker（与首页同一语言） */
  .hl {
    position: relative;
    z-index: 0;
    display: inline-block;
    padding: 0 0.1em;
  }
  .hl::before {
    content: '';
    position: absolute;
    inset: 14% -0.04em 10%;
    background: var(--hl);
    transform: rotate(-1deg);
    border-radius: 0.14em;
    z-index: -1;
  }
  .head-meta {
    margin: var(--sp-3) 0 0;
    font-size: 1rem;
    color: var(--text-2);
  }
  .stat-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent-ink);
    padding: 0 2px;
  }
  .dev-hint {
    margin-left: var(--sp-2);
    font-size: 0.85rem;
    color: var(--accent-ink);
  }

  /* —— 分类跳转：编号索引 —— */
  .cat-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .cat-jump a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--sp-1) var(--sp-2);
    transition: border-color 150ms ease, color 150ms ease;
  }
  .cat-jump a:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }
  .jump-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-ink);
  }
  .jump-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-2);
  }

  /* —— 分类节头：大号分类名 + 编号 —— */
  .cat-section {
    margin-bottom: var(--sp-6);
  }
  .cat-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-4);
    padding-bottom: var(--sp-2);
    border-bottom: 2px solid var(--line);
  }
  .cat-index {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-ink);
  }
  .cat-name {
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .cat-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-2);
  }

  /* —— 杂志网格：featured 大卡跨两列 —— */
  .note-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-3);
  }
  .note-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--sp-3) var(--sp-4);
    overflow: hidden;
    transition: transform 160ms ease, border-color 160ms ease;
  }
  /* hover 彩铅顶条（与首页 marker 同语言） */
  .note-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--hl);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }
  .note-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-ink);
  }
  .note-card:hover::before {
    transform: scaleX(1);
  }
  .note-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-2);
    margin-bottom: var(--sp-1);
  }
  .badge-new {
    font-family: var(--font-sans);
    background: var(--tag-bg);
    color: var(--text);
    border-radius: 4px;
    padding: 0 6px;
    font-size: 0.72rem;
  }
  .badge-draft {
    font-family: var(--font-sans);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 6px;
    font-size: 0.72rem;
  }
  .note-card h3 {
    margin: 0 0 var(--sp-1);
    font-size: 1.08rem;
    line-height: 1.4;
  }
  .note-card h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .note-card:hover h3 a {
    color: var(--accent-ink);
  }
  .note-summary {
    margin: 0 0 var(--sp-2);
    color: var(--text-2);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .tag {
    font-size: 0.75rem;
    color: var(--text-2);
    background: var(--surface-2);
    border-radius: 4px;
    padding: 0 6px;
  }

  /* featured 大卡：跨两列 + 更大标题 + 三行摘要 */
  .note-card.featured h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
  }
  .note-card.featured .note-summary {
    -webkit-line-clamp: 3;
    font-size: 0.98rem;
  }
  @media (min-width: 720px) {
    .note-card.featured {
      grid-column: span 2;
      padding: var(--sp-4);
    }
  }

  .empty {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    text-align: center;
    color: var(--text-2);
  }
  .empty-sub {
    font-size: 0.88rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .note-card:hover {
      transform: none;
    }
    .note-card::before {
      transition: none;
    }
    .cat-jump a {
      transition: none;
    }
  }
</style>
